# Names only — never commit real values. Set values in .env.local (dev) and Cloudflare (prod).
# Keep only the lines your layer uses.

# Every layer
NEXT_PUBLIC_SITE_URL=

# Form Worker (only if plan.md Conversion has a form) — Worker secrets in Cloudflare, never NEXT_PUBLIC_
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
FORM_TO_ADDRESS=
# Only if the provider is not the Cloudflare send_email binding:
EMAIL_PROVIDER_API_KEY=

# cms (Sanity) — public dataset, read at build time; no token in the site
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=
NEXT_PUBLIC_SANITY_API_VERSION=
# Local work without a cloud project: mock fixtures in src/sanity/mock/
CONTENT_SOURCE=

# OpenNext path only (logged server need in plan.md Decisions) — revalidation webhook
# SANITY_REVALIDATE_SECRET=
